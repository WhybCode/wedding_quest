# Formspree — vytvor formuláre na https://formspree.io a vlož ID (napr. xyzabcde)
# Jeden spoločný endpoint stačí, alebo oddelené pre RSVP / pokrm / ubytovanie.

VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mzdnpyza
VITE_FORMSPREE_RSVP=
VITE_FORMSPREE_POKRM=
VITE_FORMSPREE_UBYTOVANIE=

# Export odpovedí do CSV (npm run forms:export) — len lokálne, nikdy necommituj
# FORMSPREE_API_KEY=...
# FORMSPREE_FORM_ID=mzdnpyza

# GitHub Pages build (nastavuje sa automaticky v CI — lokálne len pri npm run build:pages)
# GITHUB_PAGES_BASE=/wedding_quest/
